# Kinz Margin Guardian Pipeline — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.

# ---- PostgreSQL ----
POSTGRES_USER=kinz_guardian
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=margin_guardian
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://kinz_guardian:change_me_in_prod@postgres:5432/margin_guardian

# ---- JWT Auth (FastAPI) ----
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- Slack Webhook (Alerting) ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ---- Airflow ----
AIRFLOW_UID=50000
_APIP_ADD_PLUGIN_MASK=true

# ---- FastAPI ----
API_PORT=8000
API_USER=admin@kinzoils.com
API_PASSWORD=change_me_in_prod

# ---- Streamlit ----
DASHBOARD_PORT=8501
